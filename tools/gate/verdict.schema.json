{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tools/gate/verdict.schema.json",
  "title": "GateVisionVerdict",
  "description": "Gate vision-review verdict (todo 6). PASS requires every checklist item pass=true and identity_score >= 4 on gates G3/G5. Every FAIL checklist item must cite a crop file in 'crop'. renders[] entries copy {name, sha256} from the render manifest so the checker can reject stale verdicts. See docs/gate/vision-review.ko.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset",
    "gate",
    "reviewer",
    "renders",
    "checklist",
    "identity_score",
    "verdict",
    "blocking"
  ],
  "properties": {
    "asset": { "type": "string", "minLength": 1 },
    "gate": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "renders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pass", "note", "crop"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "pass": { "type": "boolean" },
          "note": { "type": "string" },
          "crop": { "type": "string" }
        }
      }
    },
    "identity_score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "verdict": { "enum": ["PASS", "FAIL"] },
    "blocking": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
