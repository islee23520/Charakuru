{
  "cases": [
    {
      "name": "confirm without REVIEW_PASS",
      "steps": [
        { "gate": ["confirm", "lifecycle-empty", "G0", "--note", "too early"], "exit": 1, "contains": "NotReviewed" }
      ]
    },
    {
      "name": "require on REVIEW_PASS G0",
      "steps": [
        { "seed": "review-pass-g0" },
        { "gate": ["require", "lifecycle-seed", "G0"], "exit": 1, "contains": "AwaitingUserConfirmation:G0" }
      ]
    },
    {
      "name": "aggregate G5 alone is REVIEW_PASS",
      "steps": [
        { "aggregate": { "asset": "lifecycle-g5", "gate": "G5", "verdicts": "pass" }, "exit": 0, "json": { "status": "REVIEW_PASS" } }
      ]
    },
    {
      "name": "replay keep",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "fixture-body" }, "exit": 0 },
        { "aggregate": { "asset": "lifecycle-keep", "gate": "G0", "useImage": true, "verdicts": "pass" }, "exit": 0, "json": { "status": "REVIEW_PASS" } },
        { "gate": ["confirm", "lifecycle-keep", "G0", "--note", "kept"], "exit": 0, "json": { "status": "PASS" } },
        { "aggregate": { "asset": "lifecycle-keep", "gate": "G0", "useImage": true, "verdicts": "pass" }, "exit": 0, "json": { "status": "PASS", "unchanged": true } },
        { "assertGate": { "asset": "lifecycle-keep", "gate": "G0", "status": "PASS", "note": "kept", "superseded": 0 } }
      ]
    },
    {
      "name": "replay invalidate",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "fixture-body" }, "exit": 0 },
        { "aggregate": { "asset": "lifecycle-flip", "gate": "G0", "useImage": true, "verdicts": "pass" }, "exit": 0, "json": { "status": "REVIEW_PASS" } },
        { "gate": ["confirm", "lifecycle-flip", "G0", "--note", "first look"], "exit": 0, "json": { "status": "PASS" } },
        { "flipByte": "front.png" },
        { "imageCheck": { "kind": "body", "from": "current" }, "exit": 0 },
        { "aggregate": { "asset": "lifecycle-flip", "gate": "G0", "useImage": true, "verdicts": "pass" }, "exit": 0, "json": { "status": "REVIEW_PASS" } },
        { "assertGate": { "asset": "lifecycle-flip", "gate": "G0", "status": "REVIEW_PASS", "superseded": 1 } },
        { "gate": ["require", "lifecycle-flip", "G0"], "exit": 1, "contains": "AwaitingUserConfirmation:G0" }
      ]
    },
    {
      "name": "G0 happy iyeon body",
      "real": true,
      "steps": [
        { "imageCheck": { "kind": "body", "from": "iyeon-body" }, "exit": 0, "json": { "ok": true, "kind": "body" } },
        { "assertImage": { "file": "front.png", "span": 1010, "ratioMin": 0.75, "ratioMax": 0.82 } },
        { "aggregate": { "asset": "iyeon-body", "gate": "G0", "useImage": true, "verdicts": "pass" }, "exit": 0, "json": { "status": "REVIEW_PASS" } },
        { "gate": ["confirm", "iyeon-body", "G0", "--note", "fixture confirmation of the iyeon kit body"], "exit": 0, "json": { "status": "PASS" } },
        { "gate": ["require", "iyeon-body", "G0"], "exit": 0, "json": { "status": "PASS" } }
      ]
    },
    {
      "name": "arms down silhouette",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "fixture-arms-down" }, "exit": 1, "error": "ArmSpan:front.png" }
      ]
    },
    {
      "name": "G0 jojaepyo body width",
      "real": true,
      "steps": [
        { "imageCheck": { "kind": "body", "from": "jojaepyo-body" }, "exit": 1, "error": "BboxWidth:front.png/back.png:0.124" }
      ]
    },
    {
      "name": "G0 negative one-arm archive",
      "real": true,
      "steps": [
        { "imageCheck": { "kind": "body", "from": "jojaepyo-archive" }, "exit": 1, "error": "ViewSetIncomplete" }
      ]
    },
    {
      "name": "aggregate missing verdict",
      "steps": [
        { "aggregate": { "asset": "lifecycle-missing", "gate": "G0", "verdicts": "missing" }, "exit": 1, "error": "InputMissing:" }
      ]
    },
    {
      "name": "single verdict is not enough",
      "steps": [
        { "aggregate": { "asset": "lifecycle-one", "gate": "G3", "verdicts": "one" }, "exit": 1, "error": "VisionVerdicts:1<2" }
      ]
    },
    {
      "name": "G3 aggregate passes directly",
      "steps": [
        { "aggregate": { "asset": "lifecycle-g3", "gate": "G3", "verdicts": "pass" }, "exit": 0, "json": { "status": "PASS" } }
      ]
    },
    {
      "name": "corrupt png",
      "steps": [
        { "imageCheck": { "kind": "single_part", "from": "corrupt" }, "exit": 1, "error": "PngDecode:front.png" }
      ]
    },
    {
      "name": "auto json missing blocking",
      "steps": [
        { "auto": { "ok": true }, "aggregate": { "asset": "lifecycle-auto", "gate": "G3", "verdicts": "pass" }, "exit": 1, "error": "AutoContractInvalid" }
      ]
    },
    {
      "name": "auto json blocking not array",
      "steps": [
        { "auto": { "ok": true, "blocking": "FAILED" }, "aggregate": { "asset": "lifecycle-autob", "gate": "G3", "verdicts": "pass" }, "exit": 1, "error": "AutoContractInvalid" }
      ]
    },
    {
      "name": "same verdict path twice",
      "steps": [
        { "aggregate": { "asset": "lifecycle-samepath", "gate": "G3", "verdicts": "same-path" }, "exit": 1, "error": "ReviewerNotIndependent" }
      ]
    },
    {
      "name": "same reviewer twice",
      "steps": [
        { "aggregate": { "asset": "lifecycle-samerev", "gate": "G3", "verdicts": "same-reviewer" }, "exit": 1, "error": "ReviewerNotIndependent" }
      ]
    },
    {
      "name": "verdict checklist item failing",
      "steps": [
        { "aggregate": { "asset": "lifecycle-check", "gate": "G3", "verdicts": "failing-checklist" }, "exit": 1 },
        { "assertBlocking": { "asset": "lifecycle-check", "gate": "G3", "contains": ["ChecklistItemFailed:fixture", "VisionVerdicts:1<2"] } }
      ]
    },
    {
      "name": "G5 identity score below 4",
      "steps": [
        { "aggregate": { "asset": "lifecycle-score", "gate": "G5", "verdicts": "low-score" }, "exit": 1 },
        { "assertBlocking": { "asset": "lifecycle-score", "gate": "G5", "contains": ["IdentityScoreBelow4:1", "VisionVerdicts:1<2"] } }
      ]
    },
    {
      "name": "verdict blocking not empty",
      "steps": [
        { "aggregate": { "asset": "lifecycle-block", "gate": "G3", "verdicts": "blocking" }, "exit": 1 },
        { "assertBlocking": { "asset": "lifecycle-block", "gate": "G3", "contains": ["BlockingNotEmpty"] } }
      ]
    },
    {
      "name": "head chin line",
      "steps": [
        { "imageCheck": { "kind": "head", "from": "fixture-head" }, "exit": 0, "json": { "ok": true } },
        { "imageCheck": { "kind": "head", "from": "fixture-neck" }, "exit": 1, "error": "ChinLine:front.png" }
      ]
    },
    {
      "name": "single bad verdict reports its schema failure",
      "steps": [
        { "aggregate": { "asset": "lifecycle-onebad", "gate": "G3", "verdicts": "one-bad" }, "exit": 1, "json": { "status": "FAIL" } },
        { "assertBlocking": { "asset": "lifecycle-onebad", "gate": "G3", "contains": ["Verdict:reviewer-checklist:ChecklistItemFailed:fixture", "VisionVerdicts:0<2"] } }
      ]
    },
    {
      "name": "iyeon body scaled 50 percent",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "iyeon-body-scaled", "profile": { "longSideMin": 512, "subjectHeightMax": 0.96 } }, "exit": 0, "json": { "ok": true } },
        { "assertImage": { "file": "front.png", "ratioMin": 0.75, "ratioMax": 0.82 } }
      ]
    },
    {
      "name": "arms erased real jojaepyo",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "jojaepyo-arms-erased" }, "exit": 1, "error": "ArmSpan:front.png" }
      ]
    },
    {
      "name": "arms down real jojaepyo",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "jojaepyo-arms-down" }, "exit": 1, "error": "ArmSpan:front.png" }
      ]
    },
    {
      "name": "thick sleeve arms down real jojaepyo",
      "steps": [
        { "imageCheck": { "kind": "body", "from": "jojaepyo-arms-down-thick" }, "exit": 1, "error": "ArmSpan:front.png" }
      ]
    }
  ]
}
